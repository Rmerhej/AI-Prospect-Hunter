# Copiez ce fichier en ".env" (ignoré par Git) et choisissez vos propres mots de passe.
# Il est lu à la fois par docker compose et par Spring Boot.
DB_PASSWORD=changez-moi
DB_ROOT_PASSWORD=changez-moi-aussi

# Clé API Gemini (gratuite) : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre-cle-gemini
